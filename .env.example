# Contact form delivery via Resend (https://resend.com). Server-only - never prefix with NEXT_PUBLIC_.
# Leave blank to run without email delivery; the form will report that it is not configured.
RESEND_API_KEY=
# Verified sender, e.g. "Test One Digital <website@yourdomain.com>"
CONTACT_FROM_EMAIL=
# Inbox that receives inquiries
CONTACT_TO_EMAIL=sarah.mitchell@testonedigital.com
